NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_DATABASE_URL=postgresql://postgres.example:password@host:6543/postgres
# For verified Supabase TLS, set sslmode=verify-full in the URL and set
# SUPABASE_DATABASE_CA_PEM to the contents of certificates/prod-ca-2021.crt.
OWNER_EMAIL=owner@example.com
E2E_OWNER_EMAIL=owner@example.com
E2E_OWNER_PASSWORD=replace-with-test-owner-password
